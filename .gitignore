#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# ---- Huấn luyện mô hình (Python) ----
# Môi trường ảo (~5,5 GB) - tạo lại bằng ml_training/requirements.txt
ml_training/.venv/
__pycache__/
.ipynb_checkpoints/
# Dữ liệu ảnh (~560 MB, có giấy phép riêng) - tải lại từ nguồn ghi trong báo cáo
ml_training/data/
# Trọng số/mô hình trung gian lớn (file .tflite dùng trong app nằm ở assets/ vẫn được giữ)
ml_training/**/*.pt
ml_training/**/*.onnx
ml_training/**/*.cache
ml_training/outputs/**/weights/
